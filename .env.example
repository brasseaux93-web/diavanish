# Diavanish Environment Configuration
# All variables support both DIAVANISH_* (preferred) and legacy APERTURE_* prefixes.
#
# PRODUCTION: copy this file to .env, replace the secret, then start.
# The server refuses to start in NODE_ENV=production if the secret is missing
# or still set to the example value, or if email delivery is not configured.

# Secret key (at least 32 random characters; generate with: openssl rand -base64 48)
DIAVANISH_SECRET=change-me-to-64-random-characters

# Administrator email for initial boot setup (required in production)
# admin@diavanish.org is the real production administrator address.
DIAVANISH_ADMIN_EMAIL=admin@diavanish.org

# Email delivery (required in production — choose one)
# Option A: Resend
RESEND_API_KEY=
DIAVANISH_MAIL_FROM=Diavanish <no-reply@diavanish.org>

# Option B: Webhook (your own SMTP bridge or relay)
# DIAVANISH_MAIL_WEBHOOK=
# DIAVANISH_MAIL_WEBHOOK_SECRET=

# Groq Neutrality Engine (optional, in-memory only)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Storage path (default: data.db; Docker uses /data/diavanish.db)
DIAVANISH_DB=data.db

# Public origin (recommended for HSTS and absolute links)
# DIAVANISH_ORIGIN=https://diavanish.org

# Optional
# DIAVANISH_HSTS=1
# DIAVANISH_DEMO=1
# DIAVANISH_DEMO_IN_PRODUCTION=1   # only if you intentionally want demos on a production build
# PORT=5000
