# Diavanish Environment Configuration
# All variables support both DIAVANISH_* (preferred) and legacy APERTURE_* prefixes.

# Secret key (at least 64 random characters)
DIAVANISH_SECRET=change-me-to-64-random-characters

# Administrator email for initial boot setup
DIAVANISH_ADMIN_EMAIL=admin@diavanish.org

# Email delivery (Resend or custom Webhook relay)
# Option A: Resend
RESEND_API_KEY=
DIAVANISH_MAIL_FROM=Diavanish <no-reply@diavanish.org>

# Option B: Webhook
DIAVANISH_MAIL_WEBHOOK=
DIAVANISH_MAIL_WEBHOOK_SECRET=

# Groq Neutrality Engine (In-Memory Ephemeral LLM Transformation)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage path (default: data.db)
DIAVANISH_DB=data.db

# Optional Security and Demos
# DIAVANISH_DEMO=1
# DIAVANISH_HSTS=1
# DIAVANISH_ORIGIN=https://diavanish.org
