# Diavanish Environment Configuration
# All variables support both DIAVANISH_* (preferred) and legacy APERTURE_* prefixes.
#
# These values are the real production configuration.
# Copy this file to .env and replace only the secret with a strong random value
# before starting in production. The server refuses to start if the secret is
# missing or still set to the default string below.

# Secret key — replace with output of: openssl rand -base64 48
DIAVANISH_SECRET=change-me-to-64-random-characters

# Administrator email (real production address)
DIAVANISH_ADMIN_EMAIL=admin@diavanish.org

# Email delivery (required in production — choose one)
# Option A: Resend
RESEND_API_KEY=
DIAVANISH_MAIL_FROM=Diavanish <no-reply@diavanish.org>

# Option B: Webhook (your own SMTP bridge or relay)
# DIAVANISH_MAIL_WEBHOOK=
# DIAVANISH_MAIL_WEBHOOK_SECRET=

# Groq Neutrality Engine (optional, in-memory only)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Storage path (default: data.db; Docker uses /data/diavanish.db)
DIAVANISH_DB=data.db

# Public origin
# DIAVANISH_ORIGIN=https://diavanish.org

# Optional
# DIAVANISH_HSTS=1
# DIAVANISH_DEMO=1
# DIAVANISH_DEMO_IN_PRODUCTION=1
# PORT=5000
